# Copy to .env and fill in. docker-compose reads these; real secrets stay untracked.

# Database
# --- Optional local-db Docker profile ---
POSTGRES_USER=jago
POSTGRES_PASSWORD=jago
POSTGRES_DB=jago
# --- Database for both Docker and direct Go runs ---
# api/worker/migrate read DATABASE_URL. For a locally-installed Postgres, point it
# at your server and the jago database, e.g. the default superuser:
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/jago?sslmode=disable
# For Neon, use the connection URL from your Neon dashboard instead:
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require

# HTTP
HTTP_ADDR=:8080

# Exact frontend origins, comma-separated; no trailing slash or wildcard.
# ALLOWED_ORIGINS=https://your-project.vercel.app

# Deployment environment. Set to "production" to make config validation refuse the
# dev JWT secret below (fail-fast on a misconfigured deploy). Unset/anything else
# = dev.
# APP_ENV=production

# Auth (used from B1)
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=24h

# Tunable rule values — the pilot dials (CLAUDE.md A.3). Dev placeholders:
VALIDITY_THRESHOLD=5
RESPONSE_DEADLINE=168h
BLOCKER_REVIEW_WINDOW=72h
# There is deliberately no screening window here. A problem is public and votable
# the moment it is reported — no admin stands between filing and the feed, because
# the community (V) is the first filter and you cannot vote on what you cannot
# see. Spam and abuse are handled after publication, by a narrow takedown that is
# itself public. See CLAUDE.md A.3.1.
