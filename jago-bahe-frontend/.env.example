# Recommended for both local development and the Vercel deployment.
# Vite proxies this locally; vercel.json proxies it to Render in production.
VITE_API_URL=/api

# Vercel project settings:
# Root Directory: jago-bahe-frontend
# Framework Preset: Vite
# Build Command: npm run build
# Output Directory: dist
# Environment Variables (Production and Preview): VITE_API_URL=/api
# Redeploy after changing environment variables (Vite reads them at build time).
#
# Alternative: call Render directly, bypassing the Vercel proxy:
# VITE_API_URL=https://jago-bahe-api.onrender.com/api
# Then set this in Render's Environment and redeploy the backend:
# ALLOWED_ORIGINS=https://jago-bahe-konthe-shobai.vercel.app
# The API base includes /api; ALLOWED_ORIGINS has no path or trailing slash.
#
# The app needs no environment at all to run against a local backend.
#
# Leave VITE_API_URL unset and the app calls the same-origin /api path, which the
# Vite dev proxy (vite.config.js) forwards to localhost:8080 — so the backend
# needs no CORS. Just start the API on :8080 and `npm run dev`.
#
# Set it to an absolute URL only to hit a remote or non-default backend directly
# (which must then send CORS headers).
# VITE_API_URL=http://localhost:8080/api

# There is no mock mode (CLAUDE.md A.5.5). The mock layer was deleted in F15 —
# it had begun describing a backend that did not exist. Every screen talks to the
# real API; tests stub the api modules with vi.mock.
