# Copy to .env for Docker hosting; set your database URL and JWT secret.
# API and migrations use this same external PostgreSQL database.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require
JWT_SECRET=
# ALLOWED_ORIGINS=https://your-project.vercel.app

JWT_TTL=24h
VALIDITY_THRESHOLD=5
RESPONSE_DEADLINE=168h
BLOCKER_REVIEW_WINDOW=72h
